{
  "$schema": "https://mintlify.com/docs.json",
  "theme": "mint",
  "name": "Tea",
  "description": "Documentation for the Tea programming language.",
  "logo": {
    "light": "/assets/tea-logo-light.svg",
    "dark": "/assets/tea-logo-dark.svg"
  },
  "favicon": "/assets/tea-mark.svg",
  "styling": {
    "codeblocks": {
      "languages": {
        "custom": ["/assets/tea.tmLanguage.json"]
      }
    }
  },
  "colors": {
    "primary": "#156453",
    "light": "#70c9af",
    "dark": "#0f463a"
  },
  "seo": {
    "indexing": "all"
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "groups": [
          {
            "group": "Overview",
            "pages": ["introduction"]
          },
          {
            "group": "Getting started",
            "pages": [
              "getting-started/Write your first indicator",
              "getting-started/backtest-your-strategy",
              "getting-started/live-scanner",
              "getting-started/live-trading"
            ]
          },
          {
            "group": "Language guide",
            "pages": [
              "language-guide/program-structure",
              "language-guide/execution-model",
              "language-guide/values-and-control-flow",
              "language-guide/time-series",
              "language-guide/outputs-and-events",
              "imports",
              "requests",
              "strategy",
              "memory-model"
            ]
          },
          {
            "group": "Advanced",
            "pages": [
              "advanced/tea-compiler",
              "ir",
              "advanced/gpu-lowering",
              "geometry"
            ]
          }
        ]
      },
      {
        "tab": "Reference",
        "groups": [
          {
            "group": "Overview",
            "pages": ["reference/overview"]
          },
          {
            "group": "Language",
            "pages": [
              "reference/language/lexical-structure",
              "reference/language/types",
              "reference/language/declarations",
              "reference/language/expressions",
              "reference/language/control-flow",
              "reference/language/outputs"
            ]
          },
          {
            "group": "Built-ins",
            "pages": [
              "reference/builtins/core",
              "reference/builtins/input",
              "reference/builtins/math",
              "reference/builtins/color",
              "reference/builtins/array",
              "reference/builtins/matrix",
              "reference/builtins/map",
              "reference/builtins/request",
              "reference/builtins/market-data",
              "reference/builtins/plots",
              "reference/builtins/ta"
            ]
          },
          {
            "group": "Libraries",
            "pages": [
              "reference/libraries/trade",
              "reference/libraries/broker",
              "reference/libraries/portfolio",
              "reference/libraries/geometry"
            ]
          },
          {
