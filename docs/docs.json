            "pages": ["reference/tools/cli"]
          },
          {
            "group": "JavaScript API",
            "pages": [
              "reference/javascript/tea",
              "reference/javascript/compiler",
              "reference/javascript/lsp",
              "reference/javascript/reference",
              "reference/javascript/runtime"
            ]
          }
        ]
      }
