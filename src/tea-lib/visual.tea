//@version=1
// Visual descriptions are ordinary values. Each explicit ID names one output.

/**
 * Functions that describe plots, shapes, colors and alerts as named outputs.
 *
 * Each plotting call records its arguments in a description value and writes
 * it to the output named by its first argument, `id`; each alert call appends
 * an event to the list named by `id`. Tea draws and sends nothing: the host
 * decides how to draw or deliver each output. Tea does not check the options
 * either: a style, line style, location, size, display or format name is
 * recorded as written, so a misspelled one is not an error, and numbers such
 * as `linewidth` are recorded even when negative. Only the script itself can
 * call these functions, not a library file.
 *
 * A host recognizes each output by its type id: `visual.Plot` for
 * {@link plot}, `visual.Hline` for {@link hline}, `visual.Fill` for
 * {@link fill}, `visual.Shape` for {@link plotshape}, `visual.Character` for
 * {@link plotchar}, `visual.Background` for {@link bgcolor} and
 * `visual.BarColor` for {@link barcolor}. An alert output is a list of
 * `visual.Alert` events for {@link alertcondition}, or of
 * `visual.AlertEvent<T>` events for {@link alert}, where `T` is the type of
 * the alert's payload.
 *
 * An `id` is a constant string, unique among the script's outputs; only alert
 * calls may share one. It cannot be empty or one of `index`, `time`, `timed`
 * and `provisional`. Apart from the alerts, a call may run at most once per
 * bar, so not inside a loop. On a bar where it does not run, such as inside
 * an `if` whose condition is false, its output is `null`, which `tea run`
 * prints as `na`. An alert output holds a list on every bar, `[]` when no
 * event was appended.
 *
 * @pine Every plot and alert function takes an output `id` first, so Pine
 * Script's `plot(ta.sma(close, 2))` fails with "missing argument 'series' in
 * call to 'plot'"; write `plot("sma", ta.sma(close, 2))`. Tea cannot create
 * drawing objects: there is no `label.new`, `line.new`, `box.new`,
 * `table.new`, `polyline.new` or `linefill.new`, so every value of the
 * `label`, `line`, `box`, `table`, `polyline` and `linefill` types is `na`.
 */
library("visual")

struct Segment
    string id
    int start_time
    float start_value
    int end_time
    float end_value
    color color
    int linewidth
    string text
    bool force_overlay

/**
 * Writes a complete line segment description at this bar, without creating a drawing handle.
 *
 * Times use the same milliseconds as `time`. A conditional call describes an
 * event when it becomes known; a segment may connect earlier confirmed points.
 * Repeating a description represents the currently active segment. The host
 * owns drawing and keeps the bar of confirmation separate from the endpoints.
 *
 * @param id Name of the output this call writes.
 * @param start_time Start timestamp in milliseconds.
 * @param start_value Value at the first endpoint.
 * @param end_time End timestamp in milliseconds.
 * @param end_value Value at the second endpoint.
 * @param color Segment color; `na` lets the host choose.
 * @param linewidth Stroke width in pixels.
 * @param text Short explanation shown with the segment.
 * @param force_overlay Whether the host places this on the main price pane.
 * @returns The segment description written to `id`.
 * @example A line between the previous and current close.
 * ```tea
 * plotsegment("leg", time[1], close[1], time, close, color=color.teal)
 * ```
 * ```csv
 * time,close
 * 1704153600000,10
 * 1704240000000,12
 * ```
 * @category Geometry descriptions
 */
export plotsegment(const string id, series int start_time, series float start_value, series int end_time, series float end_value, series color color = na, const int linewidth = 1, const string text = "", const bool force_overlay = false) =>
    p = Segment.new(id, start_time, start_value, end_time, end_value, color, linewidth, text, force_overlay)
    emit id p
    return p

struct Zone
    string id
    int start_time
    int end_time
    float top
    float bottom
    color color
    string text
    bool force_overlay

/**
 * Writes a bounded time/value region at this bar, without creating a persistent box.
 *
 * For an active region, emit its complete current geometry on every bar,
 * including its original start time. A host replaces repeated descriptions
 * of the same region; it does not replay creation or deletion commands.
 *
 * @param id Name of the output this call writes.
 * @param start_time Region start timestamp in milliseconds.
 * @param end_time Region end timestamp in milliseconds.
 * @param top Upper value boundary.
 * @param bottom Lower value boundary.
 * @param color Region fill color, including transparency.
 * @param text Short explanation shown with the region.
 * @param force_overlay Whether the host places this on the main price pane.
 * @returns The region description written to `id`.
 * @example A region between two fixed price levels.
 * ```tea
 * plotzone("range", time[1], time, 12.0, 8.0, color=color.new(color.teal, 80))
 * ```
 * ```csv
 * time
 * 1704153600000
 * 1704240000000
 * ```
 * @category Geometry descriptions
 */
export plotzone(const string id, series int start_time, series int end_time, series float top, series float bottom, series color color = na, const string text = "", const bool force_overlay = false) =>
    p = Zone.new(id, start_time, end_time, top, bottom, color, text, force_overlay)
    emit id p
    return p

struct Candle
    string id
    float open
    float high
    float low
    float close
    string title
    color color
    color wickcolor
    color bordercolor

/**
 * Writes one OHLC candle description on each bar for a host to render.
 *
 * Values may be derived (for example Heikin-Ashi), so the script's title and
 * explanation must distinguish those values from the underlying market bars.
 * A missing OHLC value describes a gap.
 *
 * @param id Name of the output this call writes.
 * @param open_value Opening value.
 * @param high_value Highest value.
 * @param low_value Lowest value.
 * @param close_value Closing value.
 * @param title Display name for this candle series.
 * @param color Candle body color.
 * @param wickcolor Wick color.
 * @param bordercolor Body border color.
 * @returns The candle description written to `id`.
 * @example Describe the supplied OHLC bars.
 * ```tea
 * plotcandle("bars", open, high, low, close, color=color.teal)
 * ```
 * ```csv
 * time,open,high,low,close
 * 1704153600000,10,12,9,11
 * 1704240000000,11,14,10,13
 * ```
 * @category Plots
 */
export plotcandle(const string id, series float open_value, series float high_value, series float low_value, series float close_value, const string title = "", series color color = na, series color wickcolor = na, series color bordercolor = na) =>
    p = Candle.new(id, open_value, high_value, low_value, close_value, title, color, wickcolor, bordercolor)
    emit id p
    return p

struct Plot
    string id
    float series
    string title
    color color
    int linewidth
    string style
    bool trackprice
    float histbase
    int offset
    bool editable
    int show_last
    string display
    string format
    int precision

/**
 * Writes one value per bar, with options for drawing it, to a named output.
 *
 * Each bar's description holds the arguments under the parameter names, with
 * `NaN` for an `na` number, such as the `series` on a bar where it is `na`,
 * and `null` for an `na` color. A bar where the call does not run, such as
 * inside an `if` whose condition is false, writes no description: the output
 * is `null`.
 *
 * @param id Name of the output this call writes.
 * @param series Value to plot on the current bar; may be `na`.
 * @param title Display name, separate from `id`.
 * @param color Color on the current bar, such as {@link color.red}; it may
 * change from bar to bar. `na` records no color, leaving the choice to the
 * host.
 * @param linewidth Line width in pixels.
 * @param style How to draw the values: a `plot.style_*` constant such as
 * {@link plot.style_line}, {@link plot.style_histogram} or
 * {@link plot.style_columns}.
 * @param trackprice Whether to also mark the latest value with a horizontal
 * price line.
 * @param histbase Base level for the histogram, column and area styles.
 * @param offset Number of bars to shift the drawing by: a positive number
 * moves it right, toward later bars, and a negative number left. The value is
 * still written on the current bar.
 * @param editable Whether users may edit the output's style in the host.
 * @param show_last Number of most recent bars to draw; `0`, the default, sets
 * no limit.
 * @param display Where the output appears: a `display.*` constant such as
 * {@link display.all} or {@link display.none}.
 * @param format Number format: {@link format.inherit}, {@link format.price},
 * {@link format.volume} or {@link format.percent}.
 * @param precision Number of decimal places to show; `0`, the default, leaves
 * the choice to the host.
 * @returns `visual.Plot`: the description written to `id`. Pass it to
 * {@link fill} to shade between two plots.
 * @example
 * A 2-bar average, drawn green while the close is above it. Its `series` is
 * `na` on the first bar, and its `color` is green only at index 1.
 * ```tea
 * emit "close" close
 * average = ta.sma(close, 2)
 * plot("average", average, "SMA 2", color=close > average ? color.green : color.red, linewidth=2)
 * ```
 * ```csv
 * time,close
 * 0,10
 * 1,12
 * 2,11
 * ```
 * @pine Tea has no `join`, `force_overlay` or `linestyle` parameter; passing
 * one is an error. In Pine Script, `precision = 0` shows no decimal places; in
 * Tea, `0` is the default and leaves the choice to the host.
 * @see hline
 * @see fill
 * @category Plots
 */
export plot(
    const string id,
    series float series,
    const string title = "",
    series color color = na,
    input int linewidth = 1,
    const string style = "line",
    input bool trackprice = false,
    const float histbase = 0.0,
    input int offset = 0,
    const bool editable = true,
    input int show_last = 0,
    const string display = "all",
    const string format = "inherit",
    const int precision = 0
) =>
    p = Plot.new(id, series, title, color, linewidth, style, trackprice, histbase, offset, editable, show_last, display, format, precision)
    emit id p
    return p

struct Hline
    string id
    float price
    string title
    color color
    string linestyle
    int linewidth
    bool editable
    string display

/**
 * Writes a horizontal line at a fixed level to a named output.
 *
 * The description is written on every bar the call runs, with the same values
 * each time.
 *
 * @param id Name of the output this call writes.
 * @param price Level of the line. It can come from an input but cannot change
 * from bar to bar.
 * @param title Display name, separate from `id`.
 * @param color Line color; like `price`, it cannot change from bar to bar.
 * `na` records no color, leaving the choice to the host.
 * @param linestyle Line style: {@link hline.style_solid},
 * {@link hline.style_dotted} or {@link hline.style_dashed}.
 * @param linewidth Line width in pixels.
 * @param editable Whether users may edit the output's style in the host.
 * @param display Where the output appears: a `display.*` constant such as
 * {@link display.all} or {@link display.none}.
 * @returns `visual.Hline`: the description written to `id`, with fields named
 * after the parameters. Pass it to {@link fill} to shade between two lines.
 * @example
 * A dashed red line at `70`.
 * ```tea
 * hline("overbought", 70.0, "Overbought", color=color.red, linestyle=hline.style_dashed)
 * ```
 * @see fill
 * @see plot
 * @category Plots
 */
export hline(const string id, input float price, const string title = "", input color color = na, const string linestyle = "solid", input int linewidth = 1, const bool editable = true, const string display = "all") =>
    p = Hline.new(id, price, title, color, linestyle, linewidth, editable, display)
    emit id p
    return p

struct Fill
    string id
    string first
    string second
    color color
    string title
    bool editable
    string display

/**
 * Writes a shaded area between two plots or horizontal lines to a named output.
 *
 * @param id Name of the output this call writes.
 * @param plot1 One edge of the area: the value returned by {@link plot} or
 * {@link hline}. Only its `id` is recorded.
 * @param plot2 The other edge, given like `plot1`.
 * @param color Fill color on the current bar; it may change from bar to bar.
 * `na` records no color, leaving the choice to the host.
 * @param title Display name, separate from `id`.
 * @param editable Whether users may edit the output's style in the host.
 * @param display Where the output appears: a `display.*` constant such as
 * {@link display.all} or {@link display.none}.
 * @returns `visual.Fill`: the description written to `id`; its `first` and
 * `second` fields hold the IDs of `plot1` and `plot2`.
 * @example
 * A zone between two levels. The `zone` description names its edges by their
 * IDs, `upper` and `lower`.
 * ```tea
 * upper = hline("upper", 70.0, "Upper")
 * lower = hline("lower", 30.0, "Lower")
 * fill("zone", upper, lower, color=color.new(color.blue, 90))
 * ```
 * @see plot
 * @see hline
 * @category Plots
 */
export fill(const string id, plot1, plot2, series color color = na, const string title = "", const bool editable = true, const string display = "all") =>
    p = Fill.new(id, plot1.id, plot2.id, color, title, editable, display)
    emit id p
    return p

struct Shape
    string id
    bool series
    string title
    string style
    string location
    color color
    int offset
    string text
    color textcolor
    string size
    bool editable
    int show_last
    string display
    bool force_overlay

/**
 * Writes on each bar whether to show a shape marker there, with options for drawing it, to a named output.
 *
 * The description is written on every bar the call runs, not only where the
 * condition is true: its `series` field says whether the shape appears on
 * that bar.
 *
 * @param id Name of the output this call writes.
 * @param series Whether the shape appears on the current bar.
 * @param title Display name, separate from `id`.
 * @param style Shape to draw: a `shape.*` constant such as
 * {@link shape.circle}, {@link shape.triangleup} or {@link shape.xcross}.
 * @param location Where to place the shape: a `location.*` constant such as
 * {@link location.abovebar} or {@link location.belowbar}.
 * @param color Shape color on the current bar; `na` records no color, leaving
 * the choice to the host.
 * @param offset Number of bars to shift the drawing by: a positive number
 * moves it right, toward later bars, and a negative number left.
 * @param text Text to show with the shape.
 * @param textcolor Color of `text` on the current bar; `na` records no color,
 * leaving the choice to the host.
 * @param size Shape size: a `size.*` constant such as {@link size.auto},
 * {@link size.small} or {@link size.large}.
 * @param editable Whether users may edit the output's style in the host.
 * @param show_last Number of most recent bars to draw; `0`, the default, sets
 * no limit.
 * @param display Where the output appears: a `display.*` constant such as
 * {@link display.all} or {@link display.none}.
 * @returns `visual.Shape`: the description written to `id`, with fields named
 * after the parameters.
 * @example
 * A triangle below each bar where the close crosses above `11`. Every bar
 * writes a description; `series` is `true` only at index 1.
 * ```tea
 * emit "close" close
 * plotshape("cross", ta.crossover(close, 11.0), "Cross", style=shape.triangleup, location=location.belowbar)
 * ```
 * ```csv
 * time,close
 * 0,10
 * 1,12
 * 2,13
 * ```
 * @param force_overlay Whether the host places this mark on the main price pane.
 * @see plotchar
 * @category Shapes and characters
 */
export plotshape(const string id, series bool series, const string title = "", const string style = "circle", const string location = "abovebar", series color color = na, input int offset = 0, const string text = "", series color textcolor = na, const string size = "auto", const bool editable = true, input int show_last = 0, const string display = "all", const bool force_overlay = false) =>
    p = Shape.new(id, series, title, style, location, color, offset, text, textcolor, size, editable, show_last, display, force_overlay)
    emit id p
    return p

struct Character
    string id
    bool series
    string title
    string char
    string location
    color color
    int offset
    string text
    color textcolor
    string size
    bool editable
    int show_last
    string display
    bool force_overlay

/**
 * Writes on each bar whether to show a character marker there, with options for drawing it, to a named output.
 *
 * The description is written on every bar the call runs, not only where the
 * condition is true: its `series` field says whether the character appears on
 * that bar.
 *
 * @param id Name of the output this call writes.
 * @param series Whether the character appears on the current bar.
 * @param title Display name, separate from `id`.
 * @param char Character to draw.
 * @param location Where to place the character: a `location.*` constant such
 * as {@link location.abovebar} or {@link location.belowbar}.
 * @param color Character color on the current bar; `na` records no color,
 * leaving the choice to the host.
 * @param offset Number of bars to shift the drawing by: a positive number
 * moves it right, toward later bars, and a negative number left.
 * @param text Text to show with the character.
 * @param textcolor Color of `text` on the current bar; `na` records no color,
 * leaving the choice to the host.
 * @param size Character size: a `size.*` constant such as {@link size.auto},
 * {@link size.small} or {@link size.large}.
 * @param editable Whether users may edit the output's style in the host.
 * @param show_last Number of most recent bars to draw; `0`, the default, sets
 * no limit.
 * @param display Where the output appears: a `display.*` constant such as
 * {@link display.all} or {@link display.none}.
 * @returns `visual.Character`: the description written to `id`, with fields
 * named after the parameters.
 * @example
 * A `+` above each bar whose close is higher than the one before. `series` is
 * `false` at index 0, where `close[1]` is `na`, and at index 2.
 * ```tea
 * emit "close" close
 * plotchar("higher", close > close[1], "Higher", char="+")
 * ```
 * ```csv
 * time,close
 * 0,10
 * 1,12
 * 2,11
 * ```
 * @param force_overlay Whether the host places this mark on the main price pane.
 * @see plotshape
 * @category Shapes and characters
 */
export plotchar(const string id, series bool series, const string title = "", const string char = "", const string location = "abovebar", series color color = na, input int offset = 0, const string text = "", series color textcolor = na, const string size = "auto", const bool editable = true, input int show_last = 0, const string display = "all", const bool force_overlay = false) =>
    p = Character.new(id, series, title, char, location, color, offset, text, textcolor, size, editable, show_last, display, force_overlay)
    emit id p
    return p

struct Background
    string id
    color color
    string title
    int offset
    bool editable
    int show_last
    string display

/**
 * Writes a background color for the current bar to a named output.
 *
 * @param id Name of the output this call writes.
 * @param color Background color on the current bar; `na` records no color.
 * @param title Display name, separate from `id`.
 * @param offset Number of bars to shift the drawing by: a positive number
 * moves it right, toward later bars, and a negative number left.
 * @param editable Whether users may edit the output's style in the host.
 * @param show_last Number of most recent bars to draw; `0`, the default, sets
 * no limit.
 * @param display Where the output appears: a `display.*` constant such as
 * {@link display.all} or {@link display.none}.
 * @returns `visual.Background`: the description written to `id`, with fields
 * named after the parameters.
 * @example
 * A green tint on bars whose close is above `11`. Index 0 records no color,
 * `null`.
 * ```tea
 * emit "close" close
 * bgcolor("above", close > 11 ? color.new(color.green, 90) : na)
 * ```
 * ```csv
 * time,close
 * 0,10
 * 1,12
 * ```
 * @see barcolor
 * @category Background and bar colors
 */
export bgcolor(const string id, series color color, const string title = "", input int offset = 0, const bool editable = true, input int show_last = 0, const string display = "all") =>
    p = Background.new(id, color, title, offset, editable, show_last, display)
    emit id p
    return p

struct BarColor
    string id
    color color
    string title
    int offset
    bool editable
    int show_last
    string display

/**
 * Writes a color for drawing the current bar to a named output.
 *
 * @param id Name of the output this call writes.
 * @param color Color of the current bar; `na` records no color.
 * @param title Display name, separate from `id`.
 * @param offset Number of bars to shift the drawing by: a positive number
 * moves it right, toward later bars, and a negative number left.
 * @param editable Whether users may edit the output's style in the host.
 * @param show_last Number of most recent bars to draw; `0`, the default, sets
 * no limit.
 * @param display Where the output appears: a `display.*` constant such as
 * {@link display.all} or {@link display.none}.
 * @returns `visual.BarColor`: the description written to `id`, with fields
 * named after the parameters.
 * @example
 * Bars that close at or above their open are colored green, others red.
 * ```tea
 * emit "open" open
 * emit "close" close
 * barcolor("direction", close >= open ? color.green : color.red)
 * ```
 * ```csv
 * time,open,close
 * 0,10,12
 * 1,12,11
 * ```
 * @see bgcolor
 * @category Background and bar colors
 */
export barcolor(const string id, series color color, const string title = "", input int offset = 0, const bool editable = true, input int show_last = 0, const string display = "all") =>
    p = BarColor.new(id, color, title, offset, editable, show_last, display)
    emit id p
    return p

struct Alert
    string title
    string message

/**
 * Appends an alert event with fixed text on each bar where a condition is true.
 *
 * Each bar where `condition` is true appends one event with the fields `title`
 * and `message`, and the output `id` holds the bar's events as a list, `[]` on
 * a bar with none.
 * A condition that stays true appends an event on every bar, so pass a
 * transition such as {@link ta.crossover} to alert once per crossing. When
 * the host re-runs the current bar with live updates, each run writes only its
 * own events, replacing those of the earlier runs; combine the condition with
 * {@link barstate.isconfirmed} to append only on the bar's final run. Tea
 * sends no notification: the host decides what to do with each event.
 *
 * @param id Name of the event list this call appends to. Several
 * `alertcondition` calls may share one `id`, and one call may run several
 * times on a bar, as in a loop; the events keep the order in which the calls
 * run.
 * @param condition Whether to append an event on the current bar.
 * @param title Event title; it cannot change from bar to bar.
 * @param message Event message; it cannot change from bar to bar.
 * @returns Nothing; use the call as a statement.
 * @example
 * `above` appends an event on every bar whose close is above `11`, indexes 1,
 * 2 and 4; `cross` appends only where the close crosses above `11`, indexes 1
 * and 4. A bar without an event holds `[]`.
 * ```tea
 * emit "close" close
 * alertcondition("above", close > 11, "Above", "Close is above 11")
 * alertcondition("cross", ta.crossover(close, 11.0), "Cross", "Close crossed above 11")
 * ```
 * ```csv
 * time,close
 * 0,10
 * 1,12
 * 2,13
 * 3,10
 * 4,12
 * ```
 * @see alert
 * @category Alerts
 */
export alertcondition(const string id, series bool condition, const string title = "", const string message = "") =>
    if condition
        emit.append id Alert.new(title, message)

// Per-occurrence data stays typed through emission; hosts decide how to record it.
interface AlertPayload

type AlertEvent<T: AlertPayload>
    string title
    string message
    T data

/**
 * Appends an alert event with per-bar text and a struct payload on each bar where a condition is true.
 *
 * Each bar where `condition` is true appends one event with the fields
 * `title`, `message` and `data`, and the output `id` holds the bar's events as
 * a list, `[]` on a bar with none. Unlike {@link alertcondition}, the text can
 * change from bar to bar, and `data` carries a struct value whose fields keep
 * their types in the output. Repeated true bars and live re-runs behave as for
 * {@link alertcondition}.
 *
 * @param id Name of the event list this call appends to. Several `alert`
 * calls may share one `id` when they pass the same `data` type; an
 * `alertcondition` call cannot share it.
 * @param condition Whether to append an event on the current bar.
 * @param title Event title; may change from bar to bar.
 * @param message Event message; may change from bar to bar.
 * @param data Payload: any struct value, such as `Move.new(close, change)` in
 * the example. Numbers, strings, arrays and other values that are not structs
 * are rejected.
 * @returns Nothing; use the call as a statement.
 * @example
 * An event on each bar whose close moves by `2` or more, at indexes 1 and 3.
 * The message shows the move, and `data` keeps the struct's fields.
 * ```tea
 * struct Move
 *     float price
 *     float change
 *
 * emit "close" close
 * change = close - close[1]
 * alert("move", math.abs(change) >= 2, "Big move", "Close moved " + str.tostring(change), Move.new(close, change))
 * ```
 * ```csv
 * time,close
 * 0,10
 * 1,13
 * 2,12
 * 3,9
 * ```
 * @pine Pine Script's `alert(message, freq)` has a different signature: it
 * takes no `id`, condition, title or payload, and Tea has no `freq` parameter
 * or `alert.freq_*` constants.
 * @see alertcondition
 * @category Alerts
 */
export alert(const string id, series bool condition, series string title, series string message, data) =>
    if condition
        emit.append id AlertEvent.new(title, message, data)

/**
 * One part of a {@link ProfileRow}: a length, the color to draw it in and the
 * name of the part it belongs to.
 *
 * @category Vertical profiles
 */
export type ProfileSegment
    /** Length of the part, `0` or more, relative to the profile's longest row. */
    float value
    /** Color of the part, which a host may let users change. */
    color color
    /**
     * Name of the part, such as `"Up volume"`, which a host shows when it lets
     * users restyle it; segments with the same title share one color there.
     */
    string title = ""

/**
 * One band of a vertical profile, such as a price range, with the parts drawn in it.
 *
 * @category Vertical profiles
 */
export type ProfileRow
    /** Bottom of the band, on the axis the profile shares with the chart. */
    float low
    /** Top of the band, above `low`. The rows of one profile do not overlap. */
    float high
    /** Parts drawn side by side from the start of the box, in this order. */
    array<ProfileSegment> segments

/**
 * A line across the whole box of a vertical profile, such as a point of control.
 *
 * @category Vertical profiles
 */
export type ProfileLevel
    /** Position of the line, on the axis the profile shares with the chart. */
    float y
    /** Color of the line, which a host may let users change. */
    color color
    /**
     * Name of the line, such as `"Point of control"`, which a host shows when it
     * lets users restyle it; levels with the same title share one color there.
     */
    string title = ""

struct VerticalProfile
    string id
    int from
    int to
    array<ProfileRow> rows
    array<ProfileLevel> levels
    string title
    string display

/**
 * Writes a vertical profile, bands of the vertical axis drawn sideways inside a time box, to a named output.
 *
 * Each row is a band of the axis, such as a price range, drawn sideways from
 * `from` toward `to`; the longest row fills the box. A volume profile is one
 * use: one row per price range, its parts the volume traded on rising and on
 * falling bars. The host draws, for each `from`, only the description written
 * on the last row that carries it. Every row written is sent and kept, so
 * write a finished profile once, and a forming one only on the newest bar
 * ({@link barstate.islast}): the last of stored data, or a live bar while it
 * can still change. Each part's color is a default: a host may let users
 * restyle the parts, listed by their titles. This draws one fixed two-row
 * profile:
 *
 * ```tea
 * start = time[10]
 * rows = array.from(ProfileRow.new(100.0, 101.0, array.from(ProfileSegment.new(3.0, color.green, "Buying"))), ProfileRow.new(101.0, 102.0, array.from(ProfileSegment.new(1.0, color.red, "Selling"))))
 * levels = array.from(ProfileLevel.new(100.5, color.orange, "Point of control"))
 * verticalProfile("profile", start, time, rows, levels, "Profile")
 * ```
 *
 * @param id Name of the output this call writes.
 * @param from Start of the box, as a time such as {@link time}.
 * @param to End of the box, after `from`.
 * @param rows Bands of the profile, in any order; they must not overlap.
 * @param levels Lines across the box, such as a point of control.
 * @param title Display name, separate from `id`.
 * @param display Where the output appears: a `display.*` constant such as
 * {@link display.all} or {@link display.none}.
 * @returns The description written to `id`, with fields named after the
 * parameters.
 * @category Vertical profiles
 */
export verticalProfile(const string id, series int from, series int to, array<ProfileRow> rows, array<ProfileLevel> levels, const string title = "", const string display = "all") =>
    p = VerticalProfile.new(id, from, to, rows, levels, title, display)
    emit id p
    return p
