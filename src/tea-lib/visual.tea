//@version=1
// Visual descriptions are ordinary values. Each explicit ID names one output.

/**
 * Functions that describe plots, shapes, colors and alerts as named outputs.
 *
 * Each call records its arguments in a description value and writes it to the
 * output named by its first argument, `id`. Tea draws and sends nothing: the
 * host decides how to draw or deliver each output, so options such as
 * `linewidth` or `display` are hints recorded exactly as passed. Only the
 * script itself can call these functions, not a library file.
 *
 * An `id` is a constant string, unique among the script's outputs; only alert
 * calls may share one. It cannot be empty or one of `index`, `time`, `timed`
 * and `provisional`. Apart from the alerts, a call may run at most once per
 * row, so not inside a loop, and on a row where it does not run, such as
 * inside an `if` whose condition is false, its output holds no value.
 */
library("visual")

struct Plot
    string id
    float series
    string title
    color color
    int linewidth
    string style
    bool trackprice
    float histbase
    int offset
    bool editable
    int show_last
    string display
    string format
    int precision

/**
 * Writes one value per row, with options for drawing it, to a named output.
 *
 * This plots a 20-row average, green while the close is above it:
 *
 * ```tea
 * average = ta.sma(close, 20)
 * plot("average", average, "SMA 20", color=close > average ? color.green : color.red, linewidth=2)
 * ```
 *
 * @param id Name of the output this call writes.
 * @param series Value to plot on the current row; may be `na`.
 * @param title Display name, separate from `id`.
 * @param color Color on the current row, such as {@link color.red}; it may
 * change from row to row. `na` records no color, leaving the choice to the host.
 * @param linewidth Width of the line.
 * @param style How to draw the values: a `plot.style_*` constant such as
 * {@link plot.style_line}, {@link plot.style_histogram} or
 * {@link plot.style_columns}.
 * @param trackprice Whether to also mark the latest value with a horizontal
 * price line.
 * @param histbase Base level for the histogram, column and area styles.
 * @param offset Number of rows to shift the drawing by.
 * @param editable Whether users may edit the output's style in the host.
 * @param show_last How many of the most recent rows to draw.
 * @param display Where the output appears: a `display.*` constant such as
 * {@link display.all} or {@link display.none}.
 * @param format Number format: {@link format.inherit}, {@link format.price},
 * {@link format.volume} or {@link format.percent}.
 * @param precision Number of decimal places to show.
 * @returns The description written to `id`. Its fields hold the arguments under
 * the parameter names, such as `series` and `color`; pass it to {@link fill} to
 * shade between two plots.
 * @category Plots
 */
export plot(
    const string id,
    series float series,
    const string title = "",
    series color color = na,
    input int linewidth = 1,
    const string style = "line",
    input bool trackprice = false,
    const float histbase = 0.0,
    input int offset = 0,
    const bool editable = true,
    input int show_last = 0,
    const string display = "all",
    const string format = "inherit",
    const int precision = 0
) =>
    p = Plot.new(id, series, title, color, linewidth, style, trackprice, histbase, offset, editable, show_last, display, format, precision)
    emit id p
    return p

struct Hline
    string id
    float price
    string title
    color color
    string linestyle
    int linewidth
    bool editable
    string display

/**
 * Writes a horizontal line at a fixed level to a named output.
 *
 * @param id Name of the output this call writes.
 * @param price Level of the line. It can come from an input but cannot change
 * from row to row.
 * @param title Display name, separate from `id`.
 * @param color Line color; like `price`, it cannot change from row to row. `na`
 * records no color, leaving the choice to the host.
 * @param linestyle Line style: {@link hline.style_solid},
 * {@link hline.style_dotted} or {@link hline.style_dashed}.
 * @param linewidth Width of the line.
 * @param editable Whether users may edit the output's style in the host.
 * @param display Where the output appears: a `display.*` constant such as
 * {@link display.all} or {@link display.none}.
 * @returns The description written to `id`, with fields named after the
 * parameters; pass it to {@link fill} to shade between two lines.
 * @category Plots
 */
export hline(const string id, input float price, const string title = "", input color color = na, const string linestyle = "solid", input int linewidth = 1, const bool editable = true, const string display = "all") =>
    p = Hline.new(id, price, title, color, linestyle, linewidth, editable, display)
    emit id p
    return p

struct Fill
    string id
    string first
    string second
    color color
    string title
    bool editable
    string display

/**
 * Writes a shaded area between two plots or horizontal lines to a named output.
 *
 * The description refers to the two outputs by their IDs. This shades the area
 * between a fast and a slow average:
 *
 * ```tea
 * fast = plot("fast", ta.ema(close, 10), "Fast EMA", color=color.blue)
 * slow = plot("slow", ta.ema(close, 30), "Slow EMA", color=color.orange)
 * fill("band", fast, slow, color=color.new(color.blue, 80))
 * ```
 *
 * @param id Name of the output this call writes.
 * @param plot1 One edge of the area: the value returned by {@link plot} or
 * {@link hline}. Only its `id` is recorded.
 * @param plot2 The other edge, given like `plot1`.
 * @param color Fill color on the current row; it may change from row to row.
 * `na` records no color, leaving the choice to the host.
 * @param title Display name, separate from `id`.
 * @param editable Whether users may edit the output's style in the host.
 * @param display Where the output appears: a `display.*` constant such as
 * {@link display.all} or {@link display.none}.
 * @returns The description written to `id`; its `first` and `second` fields
 * hold the IDs of `plot1` and `plot2`.
 * @category Plots
 */
export fill(const string id, plot1, plot2, series color color = na, const string title = "", const bool editable = true, const string display = "all") =>
    p = Fill.new(id, plot1.id, plot2.id, color, title, editable, display)
    emit id p
    return p

struct Shape
    string id
    bool series
    string title
    string style
    string location
    color color
    int offset
    string text
    color textcolor
    string size
    bool editable
    int show_last
    string display

/**
 * Writes a shape marker for the rows where a condition is true to a named output.
 *
 * The description is written on every row the call runs; its `series` field
 * records whether the shape appears on that row. This marks each row where the
 * close crosses above its 20-row average:
 *
 * ```tea
 * crossed = ta.crossover(close, ta.sma(close, 20))
 * plotshape("cross", crossed, "Cross", style=shape.triangleup, location=location.belowbar, color=color.green)
 * ```
 *
 * @param id Name of the output this call writes.
 * @param series Whether the shape appears on the current row.
 * @param title Display name, separate from `id`.
 * @param style Shape to draw: a `shape.*` constant such as
 * {@link shape.circle}, {@link shape.triangleup} or {@link shape.xcross}.
 * @param location Where to place the shape: a `location.*` constant such as
 * {@link location.abovebar} or {@link location.belowbar}.
 * @param color Shape color on the current row; `na` records no color, leaving
 * the choice to the host.
 * @param offset Number of rows to shift the drawing by.
 * @param text Text to show with the shape.
 * @param textcolor Color of `text` on the current row; `na` records no color,
 * leaving the choice to the host.
 * @param size Shape size: a `size.*` constant such as {@link size.auto},
 * {@link size.small} or {@link size.large}.
 * @param editable Whether users may edit the output's style in the host.
 * @param show_last How many of the most recent rows to draw.
 * @param display Where the output appears: a `display.*` constant such as
 * {@link display.all} or {@link display.none}.
 * @returns The description written to `id`, with fields named after the
 * parameters.
 * @category Shapes and characters
 */
export plotshape(const string id, series bool series, const string title = "", const string style = "circle", const string location = "abovebar", series color color = na, input int offset = 0, const string text = "", series color textcolor = na, const string size = "auto", const bool editable = true, input int show_last = 0, const string display = "all") =>
    p = Shape.new(id, series, title, style, location, color, offset, text, textcolor, size, editable, show_last, display)
    emit id p
    return p

struct Character
    string id
    bool series
    string title
    string char
    string location
    color color
    int offset
    string text
    color textcolor
    string size
    bool editable
    int show_last
    string display

/**
 * Writes a character marker for the rows where a condition is true to a named output.
 *
 * The description is written on every row the call runs; its `series` field
 * records whether the character appears on that row.
 *
 * @param id Name of the output this call writes.
 * @param series Whether the character appears on the current row.
 * @param title Display name, separate from `id`.
 * @param char Character to draw.
 * @param location Where to place the character: a `location.*` constant such
 * as {@link location.abovebar} or {@link location.belowbar}.
 * @param color Character color on the current row; `na` records no color,
 * leaving the choice to the host.
 * @param offset Number of rows to shift the drawing by.
 * @param text Text to show with the character.
 * @param textcolor Color of `text` on the current row; `na` records no color,
 * leaving the choice to the host.
 * @param size Character size: a `size.*` constant such as {@link size.auto},
 * {@link size.small} or {@link size.large}.
 * @param editable Whether users may edit the output's style in the host.
 * @param show_last How many of the most recent rows to draw.
 * @param display Where the output appears: a `display.*` constant such as
 * {@link display.all} or {@link display.none}.
 * @returns The description written to `id`, with fields named after the
 * parameters.
 * @category Shapes and characters
 */
export plotchar(const string id, series bool series, const string title = "", const string char = "", const string location = "abovebar", series color color = na, input int offset = 0, const string text = "", series color textcolor = na, const string size = "auto", const bool editable = true, input int show_last = 0, const string display = "all") =>
    p = Character.new(id, series, title, char, location, color, offset, text, textcolor, size, editable, show_last, display)
    emit id p
    return p

struct Background
    string id
    color color
    string title
    int offset
    bool editable
    int show_last
    string display

/**
 * Writes a background color for the current row to a named output.
 *
 * This tints the rows where the close is above its 50-row average and records
 * no color for the others:
 *
 * ```tea
 * bgcolor("trend", close > ta.sma(close, 50) ? color.new(color.green, 90) : na)
 * ```
 *
 * @param id Name of the output this call writes.
 * @param color Background color on the current row; `na` records no color.
 * @param title Display name, separate from `id`.
 * @param offset Number of rows to shift the drawing by.
 * @param editable Whether users may edit the output's style in the host.
 * @param show_last How many of the most recent rows to draw.
 * @param display Where the output appears: a `display.*` constant such as
 * {@link display.all} or {@link display.none}.
 * @returns The description written to `id`, with fields named after the
 * parameters.
 * @category Background and bar colors
 */
export bgcolor(const string id, series color color, const string title = "", input int offset = 0, const bool editable = true, input int show_last = 0, const string display = "all") =>
    p = Background.new(id, color, title, offset, editable, show_last, display)
    emit id p
    return p

struct BarColor
    string id
    color color
    string title
    int offset
    bool editable
    int show_last
    string display

/**
 * Writes a color for the current row's bar to a named output.
 *
 * @param id Name of the output this call writes.
 * @param color Bar color on the current row; `na` records no color.
 * @param title Display name, separate from `id`.
 * @param offset Number of rows to shift the drawing by.
 * @param editable Whether users may edit the output's style in the host.
 * @param show_last How many of the most recent rows to draw.
 * @param display Where the output appears: a `display.*` constant such as
 * {@link display.all} or {@link display.none}.
 * @returns The description written to `id`, with fields named after the
 * parameters.
 * @category Background and bar colors
 */
export barcolor(const string id, series color color, const string title = "", input int offset = 0, const bool editable = true, input int show_last = 0, const string display = "all") =>
    p = BarColor.new(id, color, title, offset, editable, show_last, display)
    emit id p
    return p

struct Alert
    string title
    string message

/**
 * Appends an alert event with fixed text on each row where a condition is true.
 *
 * Each such row appends one event with the fields `title` and `message`; other
 * rows append nothing. A condition that stays true appends an event on every
 * row, so pass a transition such as {@link ta.crossover} to alert once per
 * crossing. When the host re-runs the current row with live updates, each run
 * replaces that row's events; combine the condition with
 * {@link barstate.isconfirmed} to append only on the row's final run. Tea
 * sends no notification: the host decides what to do with each event.
 *
 * ```tea
 * crossed = ta.crossover(close, ta.sma(close, 20))
 * alertcondition("cross", barstate.isconfirmed and crossed, "Cross", "Close crossed its 20-row average")
 * ```
 *
 * @param id Name of the event list this call appends to. Several
 * `alertcondition` calls may share one `id`; their events keep the order in
 * which the calls run.
 * @param condition Whether to append an event on the current row.
 * @param title Event title.
 * @param message Event message.
 * @returns Nothing; use the call as a statement.
 * @category Alerts
 */
export alertcondition(const string id, series bool condition, const string title = "", const string message = "") =>
    if condition
        emit.append id Alert.new(title, message)

// Per-occurrence data stays typed through emission; hosts decide how to record it.
interface AlertPayload

type AlertEvent<T: AlertPayload>
    string title
    string message
    T data

/**
 * Appends an alert event with per-row text and a struct payload on each row where a condition is true.
 *
 * Each row where `condition` is true appends one event with the fields
 * `title`, `message` and `data`; other rows append nothing. Unlike
 * {@link alertcondition}, the text can change from row to row, and `data`
 * carries a struct value whose fields keep their types in the output. Repeated
 * true rows and live re-runs behave as for {@link alertcondition}.
 *
 * ```tea
 * struct Move
 *     string symbol
 *     float price
 *
 * alert("move", barstate.isconfirmed and close > 50, "Price above 50", "Close " + str.tostring(close), Move.new(syminfo.ticker, close))
 * ```
 *
 * @param id Name of the event list this call appends to. Several `alert`
 * calls may share one `id` when they pass the same `data` type; an
 * `alertcondition` call cannot share it.
 * @param condition Whether to append an event on the current row.
 * @param title Event title; may change from row to row.
 * @param message Event message; may change from row to row.
 * @param data Payload: any struct value, such as
 * `Move.new(syminfo.ticker, close)`. Numbers, arrays and other non-struct
 * values are rejected.
 * @returns Nothing; use the call as a statement.
 * @category Alerts
 */
export alert(const string id, series bool condition, series string title, series string message, data) =>
    if condition
        emit.append id AlertEvent.new(title, message, data)
